{{define "title"}}Rapport — {{.Domain}} · LinkBounty{{end}}
{{/* Reports are ephemeral (7-day TTL) and user-specific — keep them out of the index. */}}
{{define "robots"}}noindex, follow{{end}}
{{define "canonical"}}/r/{{.JobID}}{{end}}
{{define "og:url"}}/r/{{.JobID}}{{end}}
{{define "og:title"}}Rapport de liens brisés — {{.Domain}} · LinkBounty{{end}}
{{define "og:image"}}/r/{{.JobID}}/og.png{{end}}

{{define "content"}}
<style>
  .report-page { padding: 56px 0 80px; }
  .report-page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--rule); padding-bottom: 28px; margin-bottom: 40px; }
  .report-domain-xl { font-size: clamp(38px, 5vw, 64px); font-weight: 900; letter-spacing: -.04em; text-transform: uppercase; line-height: .95; word-break: break-word; }
  .report-meta-lg { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-light); margin-top: 16px; }
  .clean-panel { border: 1px solid var(--rule); padding: 64px 40px; text-align: center; }
  .clean-headline { font-size: clamp(34px, 4.5vw, 54px); font-weight: 900; letter-spacing: -.04em; text-transform: uppercase; line-height: 1; }
  .head-running { border-bottom: 1px solid var(--rule); padding-bottom: 28px; }
  @media (max-width: 900px) {
    .report-page-head { flex-direction: column; align-items: flex-start; gap: 18px; }
  }
</style>

<section class="report-page">
  <div class="container">

{{if eq .Status "running"}}
    <div class="head-running">
      <span class="eyebrow">Inspection en cours</span>
      <h1 class="report-domain-xl" style="margin-top:14px;">{{.Domain}}</h1>
    </div>
    <div id="progress"
      hx-get="/r/{{.JobID}}/status"
      hx-trigger="every 2s"
      hx-swap="outerHTML"
      aria-live="polite"
      class="scan-wait">
      <div class="swiss-loader" aria-hidden="true"><span></span></div>
      <p class="swiss-status">Connexion au site…</p>
    </div>

{{else if eq .Status "error"}}
    <div class="clean-panel" style="max-width:640px;margin:24px auto 0;">
      <span class="eyebrow">Échec de l'inspection</span>
      <p class="clean-headline" style="font-size:clamp(26px,3.5vw,38px);margin:16px 0 14px;">Erreur lors du scan</p>
      <p class="notice-body" style="margin-bottom:28px;">{{.ErrorMsg}}</p>
      <a href="/" class="btn">Relancer une inspection</a>
    </div>

{{else}}
    {{/* status = done */}}
    <div class="report-page-head">
      <div style="min-width:0;">
        <span class="eyebrow">Rapport d'inspection</span>
        <h1 class="report-domain-xl" style="margin-top:14px;">{{.Domain}}</h1>
        <p class="report-meta-lg">
          <span style="color:{{if eq .BrokenCount 0}}var(--color-success){{else}}var(--signal){{end}};font-weight:700;">{{.BrokenCount}} lien{{if ne .BrokenCount 1}}s{{end}} brisé{{if ne .BrokenCount 1}}s{{end}}</span>
          · {{.PagesCrawled}} page{{if ne .PagesCrawled 1}}s{{end}} analysée{{if ne .PagesCrawled 1}}s{{end}}
          {{if .Unverifiable}}· {{len .Unverifiable}} non vérifiable{{if ne (len .Unverifiable) 1}}s{{end}}{{end}}
        </p>
      </div>
      <button
        onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Lien copié').catch(()=>{})"
        class="btn-outline" style="flex-shrink:0;">
        Copier le lien
      </button>
    </div>

    {{if .SPAWarning}}
    <div class="notice notice-signal" style="margin-bottom:24px;" role="alert">
      <div class="notice-title">Site dynamique détecté</div>
      <p class="notice-body">Seulement {{.ExtLinksFound}} lien{{if ne .ExtLinksFound 1}}s{{end}} externe{{if ne .ExtLinksFound 1}}s{{end}} trouvé{{if ne .ExtLinksFound 1}}s{{end}} sur {{.PagesCrawled}} pages. Ce site semble utiliser du rendu côté client (React, Vue, SPA) — LinkBounty ne peut pas exécuter JavaScript. Le rapport peut être incomplet.</p>
    </div>
    {{end}}

    {{if ge .PagesCrawled 100}}
    <div class="notice" style="margin-bottom:24px;">
      <p class="notice-body">Ce site a plus de 100 pages. Seules les 100 premières ont été analysées.</p>
    </div>
    {{end}}

    {{if eq .BrokenCount 0}}
      <div class="clean-panel">
        <span class="eyebrow" style="color:var(--color-success);">Site sain</span>
        <p class="clean-headline" style="margin:16px 0 12px;">Aucun lien brisé.</p>
        <p class="swiss-status" style="margin-bottom:28px;">0 lien brisé sur {{.PagesCrawled}} pages analysées</p>
        <button
          onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Lien copié').catch(()=>{})"
          class="btn">
          Partager ce rapport
        </button>
      </div>
    {{else}}
      <span class="section-label" style="margin-bottom:20px;">Liens brisés — {{.BrokenCount}}</span>
      {{range .Groups}}
      <div class="report-card">
        <div class="card-head">
          <span class="card-head-src" title="{{.SourcePage}}">{{truncate .SourcePage 70}}</span>
          <span class="card-head-count count-error">{{len .BrokenLinks}} brisé{{if ne (len .BrokenLinks) 1}}s{{end}}</span>
        </div>
        {{range .BrokenLinks}}
        <div class="report-row">
          <span class="status-badge error">{{if eq .StatusCode 0}}ERR{{else}}{{.StatusCode}}{{end}}</span>
          <div class="row-main">
            <span class="row-url" title="{{.TargetLink}}">{{truncate .TargetLink 80}}</span>
            {{if .ErrorMsg}}<span class="row-note">{{.ErrorMsg}}</span>{{end}}
          </div>
        </div>
        {{end}}
      </div>
      {{end}}
    {{end}}

    {{if .Unverifiable}}
    <div style="margin-top:48px;">
      <span class="section-label" style="margin-bottom:8px;">Non vérifiables — {{len .Unverifiable}}</span>
      <p class="notice-body" style="font-size:12px;color:var(--ink-light);margin:8px 0 20px;max-width:680px;">Ces liens existent probablement mais refusent les vérificateurs automatiques (ex&nbsp;: LinkedIn).</p>
      <div class="report-card">
        {{range .Unverifiable}}
        <div class="report-row">
          <span class="status-badge mute">{{.StatusCode}}</span>
          <div class="row-main">
            <span class="row-src" title="{{.SourcePage}}">{{truncate .SourcePage 60}}</span>
            <span class="row-url" title="{{.TargetLink}}">{{truncate .TargetLink 80}}</span>
            {{if .ErrorMsg}}<span class="row-note">{{if eq .ErrorMsg "bot-blocking response (999) — link likely valid"}}Ce site bloque les vérificateurs automatiques (code 999){{else}}{{.ErrorMsg}}{{end}}</span>{{end}}
          </div>
        </div>
        {{end}}
      </div>
    </div>
    {{end}}

    {{if .Redirects}}
    <div style="margin-top:48px;">
      <span class="section-label" style="margin-bottom:20px;">Redirections — {{len .Redirects}}</span>
      <div class="report-card">
        {{range .Redirects}}
        <div class="report-row">
          <span class="status-badge redirect">{{.StatusCode}}</span>
          <div class="row-main">
            <span class="row-src" title="{{.SourcePage}}">{{truncate .SourcePage 60}}</span>
            <span class="row-url" title="{{.TargetLink}}">{{truncate .TargetLink 80}}</span>
          </div>
        </div>
        {{end}}
      </div>
    </div>
    {{end}}

    {{if .ExtLinksTruncated}}
    <p class="swiss-status" style="text-align:center;margin-top:40px;">{{.ExtLinksFound}} liens externes détectés — seuls les 500 premiers ont été vérifiés.</p>
    {{end}}

{{end}}

  </div>
</section>
{{end}}
