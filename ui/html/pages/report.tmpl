{{define "title"}}Rapport — {{.Domain}} · LinkBounty{{end}}

{{define "content"}}
{{if eq .Status "running"}}
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold mb-1">{{.Domain}}</h1>
    <p class="text-[var(--color-muted)] text-sm">Scan en cours…</p>
  </div>
  <div id="progress"
    hx-get="/r/{{.JobID}}/status"
    hx-trigger="every 2s"
    hx-swap="outerHTML"
    aria-live="polite"
    class="flex flex-col items-center gap-4 py-12">
    <div class="animate-spin h-8 w-8 border-2 border-[var(--color-accent)] border-t-transparent rounded-full"></div>
    <p class="text-[var(--color-muted)]">Connexion au site…</p>
  </div>

{{else if eq .Status "error"}}
  <div class="p-6 bg-red-50 border border-red-200 rounded-[var(--radius-md)] text-center">
    <p class="font-medium text-[var(--color-error)] mb-2">Erreur lors du scan</p>
    <p class="text-sm text-[var(--color-muted)] mb-4">{{.ErrorMsg}}</p>
    <a href="/" class="inline-block px-5 py-2 bg-[var(--color-accent)] text-white text-sm font-medium rounded-[var(--radius-sm)] hover:opacity-90 transition-opacity">
      Réessayer
    </a>
  </div>

{{else}}
  {{/* status = done */}}
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">{{.Domain}}</h1>
      <p class="text-[var(--color-muted)] text-sm mt-0.5">
        {{.BrokenCount}} lien{{if ne .BrokenCount 1}}s{{end}} brisé{{if ne .BrokenCount 1}}s{{end}}
        · {{.PagesCrawled}} page{{if ne .PagesCrawled 1}}s{{end}} analysée{{if ne .PagesCrawled 1}}s{{end}}
      </p>
    </div>
    <button
      onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Lien copié ✓').catch(()=>{})"
      class="self-start sm:self-auto px-4 py-2 border border-[var(--color-border)] rounded-[var(--radius-sm)] text-sm hover:bg-[var(--color-surface)] transition-colors"
      style="min-height: 44px;"
    >
      Copier le lien du rapport
    </button>
  </div>

  {{if eq .BrokenCount 0}}
    <div class="p-8 bg-green-50 border border-green-200 rounded-[var(--radius-md)] text-center">
      <p class="text-2xl mb-2">✓</p>
      <p class="font-medium text-[var(--color-success)] text-lg mb-1">Votre site est propre.</p>
      <p class="text-sm text-[var(--color-muted)] mb-4">0 lien brisé sur {{.PagesCrawled}} pages analysées.</p>
      <button
        onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Lien copié ✓').catch(()=>{})"
        class="px-5 py-2 bg-[var(--color-accent)] text-white text-sm font-medium rounded-[var(--radius-sm)] hover:opacity-90 transition-opacity"
      >
        Partager ce rapport
      </button>
    </div>
  {{else}}
    {{if ge .PagesCrawled 100}}
    <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-[var(--radius-sm)] text-sm text-amber-800">
      Ce site a plus de 100 pages. Seules les 100 premières ont été analysées.
    </div>
    {{end}}

    {{range .Groups}}
    <details class="mb-4 border border-[var(--color-border)] rounded-[var(--radius-md)] bg-[var(--color-surface)] open:shadow-sm" open>
      <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none">
        <span class="font-mono text-sm truncate" title="{{.SourcePage}}">{{truncate .SourcePage 80}}</span>
        <span class="shrink-0 ml-3 text-xs font-medium text-[var(--color-error)] bg-red-50 px-2 py-0.5 rounded">
          {{len .BrokenLinks}} brisé{{if ne (len .BrokenLinks) 1}}s{{end}}
        </span>
      </summary>
      <div class="px-4 pb-3 divide-y divide-[var(--color-border)]">
        {{range .BrokenLinks}}
          <div class="flex items-start gap-3 py-2">
            <span class="shrink-0 mt-0.5 text-xs font-mono px-1.5 py-0.5 rounded
              {{if eq .StatusCode 0}}bg-red-100 text-red-700
              {{else if ge .StatusCode 500}}bg-red-100 text-red-700
              {{else}}bg-amber-100 text-amber-700{{end}}">
              {{if eq .StatusCode 0}}ERR{{else}}{{.StatusCode}}{{end}}
            </span>
            <div class="min-w-0">
              <p class="font-mono text-sm truncate" title="{{.TargetLink}}">{{truncate .TargetLink 80}}</p>
              {{if .ErrorMsg}}<p class="text-xs text-[var(--color-muted)] mt-0.5">{{.ErrorMsg}}</p>{{end}}
            </div>
          </div>
        {{end}}
      </div>
    </details>
    {{end}}
  {{end}}

  {{if .Redirects}}
  <div class="mt-10">
    <h2 class="text-sm font-medium text-[var(--color-muted)] uppercase tracking-wider mb-3">
      Redirections ({{len .Redirects}})
    </h2>
    <div class="border border-[var(--color-border)] rounded-[var(--radius-md)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
      {{range .Redirects}}
      <div class="flex items-start gap-3 px-4 py-2">
        <span class="shrink-0 mt-0.5 text-xs font-mono px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">
          {{.StatusCode}}
        </span>
        <div class="min-w-0">
          <p class="font-mono text-xs text-[var(--color-muted)] truncate" title="{{.SourcePage}}">{{truncate .SourcePage 60}}</p>
          <p class="font-mono text-sm truncate" title="{{.TargetLink}}">{{truncate .TargetLink 80}}</p>
        </div>
      </div>
      {{end}}
    </div>
  </div>
  {{end}}

{{end}}
{{end}}
