{{define "title"}}LinkBounty — Vérificateur de liens brisés gratuit{{end}}

{{define "content"}}
<div class="text-center max-w-xl mx-auto">
  <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-text)] leading-tight mb-4">
    Vos liens brisés coûtent du trafic<br>et de la crédibilité. Silencieusement.
  </h1>
  <p class="text-[var(--color-muted)] mb-10">
    Entrez l'URL de votre site et recevez un rapport de liens brisés en quelques secondes.
  </p>

  <form
    action="/scan"
    method="POST"
    class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-end"
  >
    <div class="flex-1 text-left">
      <label for="url-input" class="block text-sm font-medium text-[var(--color-text)] mb-1">
        URL de votre site
      </label>
      <input
        id="url-input"
        type="url"
        name="url"
        placeholder="https://monblog.fr"
        required
        class="w-full px-4 py-3 text-base border border-[var(--color-border)] rounded-[var(--radius-sm)] bg-[var(--color-surface)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent"
        style="font-size: 16px;"
        aria-describedby="url-hint"
      >
    </div>
    <button
      type="submit"
      class="px-6 py-3 bg-[var(--color-accent)] text-white font-medium rounded-[var(--radius-sm)] hover:opacity-90 transition-opacity"
      style="min-height: 44px;"
    >
      Scan gratuit
    </button>
  </form>

  <p id="url-hint" class="mt-3 text-sm text-[var(--color-muted)]">
    Sans compte · Sans plugin · &lt; 1 minute
  </p>
</div>

<div class="mt-20 grid sm:grid-cols-3 gap-6 text-center text-sm">
  <div class="p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-md)]">
    <div class="text-2xl font-bold text-[var(--color-accent)] mb-1">100</div>
    <div class="text-[var(--color-muted)]">pages analysées par scan</div>
  </div>
  <div class="p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-md)]">
    <div class="text-2xl font-bold text-[var(--color-accent)] mb-1">7j</div>
    <div class="text-[var(--color-muted)]">rapport partageable</div>
  </div>
  <div class="p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-md)]">
    <div class="text-2xl font-bold text-[var(--color-accent)] mb-1">0</div>
    <div class="text-[var(--color-muted)]">compte requis</div>
  </div>
</div>
{{end}}
