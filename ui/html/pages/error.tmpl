{{define "title"}}Erreur · LinkBounty{{end}}
{{define "robots"}}noindex, nofollow{{end}}

{{define "content"}}
<section style="padding:80px 0;">
  <div class="container">
    <div style="max-width:560px;margin:0 auto;text-align:center;">
      <div style="font-size:clamp(72px,12vw,128px);font-weight:900;letter-spacing:-.04em;line-height:1;color:var(--signal);">404</div>
      <p class="section-label" style="margin:20px 0;">Piste perdue</p>
      <p class="notice-body" style="font-size:16px;margin-bottom:32px;">{{.Message}}</p>
      <a href="/" class="btn">Nouvelle inspection</a>
    </div>
  </div>
</section>
{{end}}
