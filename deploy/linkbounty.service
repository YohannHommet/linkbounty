[Unit]
Description=LinkBounty broken link checker
After=network.target

[Service]
Type=simple
User=linkbounty
WorkingDirectory=/opt/linkbounty
ExecStart=/opt/linkbounty/linkbounty
Restart=on-failure
RestartSec=5s

# PLACEHOLDER: adjust domain in SITE_URL if deploying under a different hostname
Environment=ADDR=:8080
Environment=DB_PATH=/opt/linkbounty/data/linkbounty.db
Environment=UI_DIR=/opt/linkbounty/ui/html
Environment=SITE_URL=https://linkbounty.io

# Hardening: binary + templates are read-only; only the data dir needs writes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/linkbounty/data

[Install]
WantedBy=multi-user.target
